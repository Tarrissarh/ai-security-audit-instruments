{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-audit/schemas/findings.schema.json",
  "title": "Audit findings document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "generated_at",
    "verdict",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "performed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "confidence",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "confidence": {
            "enum": [
              "VERIFIED",
              "DOCUMENTED",
              "INFERRED",
              "UNVERIFIED",
              "NOT TESTED",
              "NOT APPLICABLE"
            ]
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  }
}

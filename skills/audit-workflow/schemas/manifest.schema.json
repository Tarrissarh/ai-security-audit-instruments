{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-audit/v5.2/manifest.schema.json",
  "title": "Audit workflow manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "target",
    "report_dir",
    "state",
    "stages",
    "docs_checksums"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "enum": [
            "skill",
            "agent",
            "command",
            "mcp",
            "lsp",
            "hooks",
            "auto"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "report_dir": {
      "type": "string"
    },
    "state": {
      "enum": [
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PREFLIGHT",
        "AUDIT",
        "IMPROVE",
        "MODERNIZE",
        "DOCS",
        "VALIDATE"
      ],
      "patternProperties": {
        "^(PREFLIGHT|AUDIT|IMPROVE|MODERNIZE|DOCS|VALIDATE)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "attempts",
            "artifact",
            "sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "PENDING",
                "COMPLETE",
                "PARTIAL",
                "SKIPPED",
                "BLOCKED",
                "FAILED"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "artifact": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          }
        }
      }
    },
    "docs_checksums": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
